# Database
DB_PASSWORD=your_secure_database_password

# JWT Secret (minimum 32 characters for security)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters

# Tapo Camera Credentials (optional)
TAPO_EMAIL=your_tapo_email@example.com
TAPO_PASSWORD=your_tapo_cloud_password
TAPO_API_PASSWORD=your_tapo_api_password

# Camera Account (locally on camera)
TAPO_CAMERA_USERNAME=your_camera_username
TAPO_CAMERA_PASSWORD=your_camera_password

# Recordings Storage Path
RECORDINGS_HOST_PATH=./recordings

# Service URLs
TAPO_SERVICE_URL=http://tapo-rest:80
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_HLS_URL=http://mediamtx:8888
